# Neon connection string. Local and hosted desks use the same database.
DATABASE_URL=
# At least 32 characters. Generate with: npx auth secret
BETTER_AUTH_SECRET=
# Public URL of this app, with no trailing slash. Use http://localhost:3000 locally.
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Google OAuth client. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend HTTPS mail. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Shared secret for the 4:00 PM check. Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional. Judges roles the field lists miss. Free Gemini key from https://aistudio.google.com/apikey. Scan still works if this is empty.
MATCH_API_KEY=
